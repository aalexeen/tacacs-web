# TACACS+ Web UI — environment variables
# Copy this file to .env and fill in the values.

# Required: random secret for signing session cookies
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-in-production

# Path to the tac_plus-ng config file
TACACS_CONFIG=/etc/tac_plus-ng/tac_plus-ng.cfg

# Path to the tac_plus-ng binary (for -P syntax check)
TACACS_BIN=/usr/local/sbin/tac_plus-ng

# Directory containing log files
TACACS_LOG_DIR=/var/log/tac_plus-ng

# Directory for config backups
BACKUP_DIR=/var/backups/tac_plus-ng

# Path to the users JSON file (relative or absolute)
USERS_FILE=users.json

# systemd service name for daemon control
TACACS_SERVICE=tac_plus-ng
